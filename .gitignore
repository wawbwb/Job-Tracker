__pycache__/
*.py[cod]

# Local development files
.vscode/*.log
*.log

# Generated Windows application bundles
/build/
/dist/
/dist.zip

# Database and browser-session copies outside the data directory
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
**/state.json
